/UnityProject/Library/
/UnityProject/Temp/
/UnityProject/Obj/
/UnityProject/Logs/
/UnityProject/UserSettings/
/UnityProject/MemoryCaptures/
/UnityProject/Build/
/UnityProject/Builds/
/Builds/
/Tools/Source2Viewer/
# Unity regenerates its own project files; projects under DotNet/ are versioned.
/UnityProject/*.csproj
/UnityProject/*.sln
/UnityProject/*.slnx
/DotNet/**/bin/
/DotNet/**/obj/
/Converted/
# Models converted from the local Dota 2 install (Tools/convert-models.py) are versioned
# so the project opens on Windows and builds for Android without a Dota 2 install. *.glb go through Git LFS.
/Research/Наблюдение/Видео/
*.mp4
*.mov
/*.zip
*.apk
*.aab
*.keystore
.DS_Store
__pycache__/

# Original Valve resources extracted from the local Dota 2 install (Tools/extract-resources.py) are versioned;
# manifest.tsv lists their CRC32 so a re-extraction can be verified.
# Obsolete files kept for review before deletion
/Удалить/
# Scratch files of Kiro workflow runs (current task, verification result)
/.kiro/workflow-output/
# Results of the last local test/smoke run (Tools/unity-tests.sh, Tools/mac-smoke.sh)
/Research/unity-tests.xml
/Research/unity-tests.log
/Research/mac-smoke.log
